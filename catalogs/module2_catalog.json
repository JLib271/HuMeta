  "tpb_measurement_examples": {
    "agreement_scale": "1=Strongly disagree|2=Disagree|3=Neither agree nor disagree|4=Agree|5=Strongly agree",
    "behavior_scale": "0=Never|1=Rarely|2=Sometimes|3=Often|4=Always",
    "variables": {
      "Attitude Toward the Behavior": {
        "survey": [
          "It would be good for me to {behavior_phrase}.",
          "It would be beneficial for me to {behavior_phrase}.",
          "For me, {behavior_phrase} would be worthwhile."
        ],
        "question": "What are your thoughts about {action}{context_phrase}, and how does it relate to {topic}?",
        "drawing": "Draw how you feel about {action}{context_phrase}."
      },
      "Subjective Norms": {
        "survey": [
          "People important to me think I should {behavior_phrase}.",
          "People whose opinions I value would approve of my decision to {behavior_phrase}.",
          "People like me are expected to {behavior_phrase}."
        ],
        "question": "How do people important to you influence your views about {action}{context_phrase}?",
        "drawing": "Draw how people around you influence {action}{context_phrase}."
      },
      "Perceived Behavioral Control": {
        "survey": [
          "I am confident that I can {behavior_phrase}.",
          "Whether I {behavior_phrase} is mostly under my control.",
          "I have the resources and opportunities needed to {behavior_phrase}."
        ],
        "question": "What makes it easier or harder for you to {action}{context_phrase}?",
        "drawing": "Draw what helps or gets in the way when you {action}{context_phrase}."
      },
      "Behavioral Intention": {
        "survey": [
          "I intend to {behavior_phrase}.",
          "I plan to {behavior_phrase}.",
          "I expect that I will {behavior_phrase}."
        ],
        "question": "What, if anything, do you plan to do about {action}{context_phrase}?",
        "drawing": "Draw what you plan to do about {action}{context_phrase}."
      },
      "Behavior": {
        "survey": [
          "During {behavior_period}, how often did you {action}{context_phrase}?",
          "When an opportunity arose during {behavior_period}, how often did you {action}{context_phrase}?",
          "How consistently did you {behavior_phrase}?"
        ],
        "question": "Please describe your experience with {action}{context_phrase}{timeframe_phrase}.",
        "drawing": "Draw an experience of {action}{context_phrase}{timeframe_phrase}."
      }
    },
    "default_question": "How does {construct} relate to {topic} in your experience?",
    "default_drawing": "Draw how {construct} relates to {topic}."
  }
