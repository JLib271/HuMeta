{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/JLib271/HuMeta/library/schema/frameworks.schema.json",
  "title": "Frameworks: theories, theoretical lenses, and framework approaches",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "vocabulary_version",
    "frameworks"
  ],
  "properties": {
    "vocabulary_version": {
      "type": "integer",
      "minimum": 1
    },
    "note": {
      "type": "string"
    },
    "frameworks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "kind",
          "description",
          "fields",
          "constructs",
          "paths"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "theory",
              "lens",
              "own",
              "exploratory"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "citation": {
            "type": "string"
          },
          "doi": {
            "type": "string",
            "pattern": "^10\\.\\d{4,9}/\\S+$"
          },
          "citation_status": {
            "enum": [
              "provided",
              "added",
              "verified"
            ]
          },
          "fields": {
            "type": "array",
            "items": {
              "enum": [
                "education",
                "social_sciences",
                "humanities",
                "arts",
                "other_field"
              ]
            }
          },
          "constructs": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "label"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*$"
                },
                "label": {
                  "type": "string",
                  "minLength": 1
                },
                "definition": {
                  "type": "string"
                },
                "shared_construct_id": {
                  "type": "string"
                },
                "shared_construct_match": {
                  "enum": [
                    "exact",
                    "close",
                    "related"
                  ]
                }
              }
            },
            "description": "The theory's constructs. shared_construct_id links one to library/constructs.json."
          },
          "paths": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "from",
                "to",
                "relationship"
              ],
              "properties": {
                "from": {
                  "type": "string"
                },
                "to": {
                  "type": "string"
                },
                "relationship": {
                  "type": "string"
                }
              }
            }
          },
          "disciplines": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "biology",
                "chemistry",
                "physics",
                "geoscience",
                "climate_science",
                "astronomy",
                "mathematics",
                "computer_science",
                "engineering",
                "general_stem",
                "psychology",
                "economics",
                "education_studies",
                "sociology",
                "anthropology",
                "law",
                "political_science",
                "human_geography",
                "media_communication",
                "history",
                "archaeology",
                "languages_literature",
                "philosophy_religion",
                "visual_arts",
                "performing_arts",
                "other_humanities",
                "other_social_science",
                "other_discipline"
              ]
            },
            "description": "Disciplines (HuMeta discipline vocabulary) where the framework is widely used; for browsing."
          },
          "status": {
            "enum": [
              "draft"
            ],
            "description": "draft: added as a starting point; needs review by experts in the field."
          }
        }
      }
    }
  }
}
