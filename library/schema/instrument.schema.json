{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/JLib271/humeta-library/blob/main/schema/instrument.schema.json",
  "title": "Instrument record",
  "description": "One measurement instrument (survey, concept inventory, observation protocol, rubric, ...). Describes the instrument; never stores item text unless access.item_text_shareable is true.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "instrument_type",
    "participants",
    "description",
    "construct_ids",
    "disciplines",
    "settings",
    "original_citation",
    "access",
    "versions",
    "dimensions",
    "review",
    "info_sources",
    "variable_prefix"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "Stable slug. Must match the file name. Never change after publishing."
    },
    "name": {
      "type": "string",
      "minLength": 3
    },
    "acronym": {
      "type": "string"
    },
    "instrument_type": {
      "enum": [
        "concept_inventory",
        "attitude_beliefs_survey",
        "self_report_scale",
        "observation_protocol",
        "interview_protocol",
        "rubric",
        "performance_task",
        "other"
      ]
    },
    "participants": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      },
      "description": "Who the instrument gathers data about, from the HuMeta participant_role vocabulary (the HuMeta profile's vocabularies.json), e.g. students, educators, community_members. For an observation protocol, the people observed."
    },
    "description": {
      "type": "string",
      "minLength": 20,
      "description": "What it measures and how, in the contributor's own words. Do not paste abstracts."
    },
    "construct_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      },
      "description": "Constructs from constructs.json measured by the instrument as a whole."
    },
    "construct_mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "description": "Review status of the mapping from this instrument (and its dimensions) to constructs. Mappings are provisional until the HuMeta governance committee approves them; researchers decide whether an instrument fits their own construct.",
      "properties": {
        "status": {
          "enum": [
            "provisional",
            "approved"
          ]
        },
        "decided_on": {
          "type": "string",
          "format": "date"
        },
        "decided_by": {
          "type": "string"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "disciplines": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      },
      "description": "From the HuMeta discipline vocabulary (ANZSRC FoR ids such as anzsrc_37, or discipline_general)."
    },
    "education_levels": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      },
      "description": "Education levels the instrument has been used with, from the HuMeta education_level vocabulary (ISCED-based: primary, lower_secondary, upper_secondary, short_cycle_tertiary, bachelors, masters, doctoral, adult_education, informal_learning). May be empty for instruments not used in education."
    },
    "settings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      },
      "description": "Where the instrument is used, from the HuMeta learning_environment vocabulary, e.g. postsecondary_classroom, k12_classroom, laboratory, museum_exhibit, online_course."
    },
    "original_citation": {
      "$ref": "#/$defs/citation"
    },
    "access": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "access_type",
        "item_text_shareable",
        "terms_summary"
      ],
      "properties": {
        "access_type": {
          "enum": [
            "open_download",
            "free_registration",
            "restricted_verified_educators",
            "request_from_developer",
            "publisher_permission",
            "commercial",
            "unclear"
          ]
        },
        "item_text_shareable": {
          "type": "boolean",
          "description": "True only if the terms explicitly allow republishing items. Requires item_text_basis. The library still links rather than copies by default."
        },
        "item_text_basis": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "basis",
            "license",
            "evidence"
          ],
          "properties": {
            "basis": {
              "enum": [
                "open_license",
                "public_domain",
                "written_permission"
              ]
            },
            "license": {
              "type": "string",
              "description": "License the item text is released under in this library, e.g. 'CC BY 4.0', 'CC BY-NC-SA 3.0', 'Public domain'."
            },
            "evidence": {
              "type": "string",
              "description": "Where the permission is documented: license URL, developer statement URL, or a note that written permission is on file and with whom."
            },
            "granted_by": {
              "type": "string"
            },
            "granted_on": {
              "type": "string",
              "format": "date"
            }
          }
        },
        "answer_key_shareable": {
          "type": "boolean",
          "default": false,
          "description": "Whether correct answers may be stored with item text. Separate from item text because public keys can weaken a test."
        },
        "terms_summary": {
          "type": "string"
        },
        "terms_url": {
          "type": "string",
          "format": "uri"
        },
        "download_url": {
          "type": "string",
          "format": "uri"
        }
      },
      "if": {
        "properties": {
          "item_text_shareable": {
            "const": true
          }
        }
      },
      "then": {
        "required": [
          "item_text_basis"
        ]
      }
    },
    "versions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/version"
      }
    },
    "dimensions": {
      "type": "array",
      "description": "Subscales, factors, concept categories, or code groups. Empty if the instrument is scored only as a whole.",
      "items": {
        "$ref": "#/$defs/dimension"
      }
    },
    "related_instrument_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "review": {
      "$ref": "#/$defs/review"
    },
    "info_sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "format": "uri"
      },
      "description": "Pages the record's facts were taken from, so a reviewer can re-check them."
    },
    "variable_prefix": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]{1,9}$",
      "description": "Short prefix for generated variable names (e.g. 'gci' -> gci_q05). Must be unique across the library and never change once data exist."
    },
    "development": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "basis"
      ],
      "description": "How the instrument was conceived. A theory is not required: many instruments are built from a definition of what to measure.",
      "properties": {
        "basis": {
          "enum": [
            "theory",
            "construct_definition",
            "practical_need",
            "not_reported"
          ],
          "description": "theory = built from a named theory or framework; construct_definition = built from a definition of the construct, with no theory named; practical_need = built to answer a practical or instructional question; not_reported = the sources do not say."
        },
        "framework_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          },
          "description": "Theories or frameworks in frameworks.json the instrument was built on."
        },
        "theory_named": {
          "type": "string",
          "description": "A theory not (yet) in the library, as named by the developers."
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "rubric_review": {
      "type": "object",
      "description": "Rubric criteria met, as judged by a reviewer from the instrument's development and validation sources. Keys are rubric category ids.",
      "propertyNames": {
        "enum": [
          "item_reliability",
          "forms_reliability",
          "item_analysis",
          "pre_item_content",
          "post_item_content",
          "communication",
          "cultural",
          "scale_analysis",
          "criterion_construct",
          "mc_item_writing",
          "likert_item_writing"
        ]
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "criteria",
          "source"
        ],
        "properties": {
          "criteria": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[A-Z]$"
            }
          },
          "source": {
            "type": "string",
            "description": "Citation or link documenting the criteria."
          },
          "notes": {
            "type": "string"
          },
          "reviewed_by": {
            "type": "string"
          },
          "reviewed_on": {
            "type": "string"
          }
        }
      }
    },
    "commons_records": {
      "type": "array",
      "description": "Deposits about this instrument on Knowledge Commons (KCWorks), ideally one record in the HuMeta Instrument Library collection holding the instrument, its manual, item and scoring files, and a paper where the license allows.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "url",
          "kind"
        ],
        "properties": {
          "url": {
            "type": "string",
            "format": "uri"
          },
          "doi": {
            "type": "string",
            "pattern": "^10\\.\\d{4,9}/\\S+$"
          },
          "kind": {
            "enum": [
              "instrument",
              "manual",
              "paper",
              "item_set",
              "link",
              "other"
            ]
          },
          "label": {
            "type": "string"
          },
          "in_stemedplus_collection": {
            "type": "boolean",
            "description": "true once the deposit has been approved into the HuMeta Instrument Library collection (or its parent, STEMEd+)."
          },
          "license": {
            "type": "string",
            "description": "License chosen at deposit, e.g. CC BY 4.0, CC BY-SA 4.0, CC BY-NC 4.0, CC0, All rights reserved."
          },
          "deposited_by_rights_holder": {
            "type": "boolean",
            "description": "true when the depositor holds the rights (e.g. the developer), so the license applies to the deposited content."
          },
          "contents": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "instrument",
                "manual",
                "paper",
                "item_files",
                "scoring",
                "other"
              ]
            },
            "description": "What the deposit holds when it bundles several files in one record (the recommended way)."
          }
        }
      }
    },
    "developers": {
      "type": "array",
      "minItems": 1,
      "description": "The instrument's developers, as named in its original citation. Exported as DataCite creators.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "Family name, given names or initials (e.g. 'Libarkin, Julie C.')."
          },
          "orcid": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{4}-\\d{4}-\\d{3}[\\dX]$"
          }
        }
      }
    }
  },
  "$defs": {
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 10
        },
        "doi": {
          "type": "string",
          "pattern": "^10\\.\\d{4,9}/\\S+$"
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "version": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version_id",
        "label",
        "language",
        "response_format",
        "scoring"
      ],
      "properties": {
        "version_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "label": {
          "type": "string"
        },
        "language": {
          "type": "string",
          "description": "BCP-47 tag, e.g. en, es, de."
        },
        "discipline_adaptation": {
          "type": "string"
        },
        "year": {
          "type": [
            "integer",
            "null"
          ]
        },
        "form_type": {
          "enum": [
            "fixed_form",
            "item_bank"
          ],
          "default": "fixed_form",
          "description": "fixed_form = everyone takes the same items. item_bank = users assemble subtests from a pool; item_count is the pool size."
        },
        "subtest_length": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "description": "For item banks: recommended number of items per subtest."
        },
        "item_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "administration_minutes": {
          "type": [
            "string",
            "null"
          ]
        },
        "adapted_from_version_id": {
          "type": "string"
        },
        "response_format": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "enum": [
                "likert",
                "multiple_choice",
                "multiple_response",
                "dichotomous",
                "interval_coding",
                "rating_scale",
                "open_response",
                "mixed"
              ]
            },
            "scale_points": {
              "type": [
                "integer",
                "null"
              ]
            },
            "anchors": {
              "type": "string"
            },
            "notes": {
              "type": "string"
            }
          }
        },
        "scoring": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "method"
          ],
          "properties": {
            "method": {
              "enum": [
                "sum_or_mean",
                "percent_correct",
                "percent_favorable_vs_expert",
                "code_frequency",
                "rubric_levels",
                "irt",
                "other"
              ]
            },
            "notes": {
              "type": "string"
            }
          }
        },
        "citation": {
          "$ref": "#/$defs/citation"
        }
      }
    },
    "dimension": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dimension_id",
        "name",
        "basis",
        "construct_ids"
      ],
      "properties": {
        "dimension_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "name": {
          "type": "string"
        },
        "basis": {
          "enum": [
            "empirical_factor",
            "design_category",
            "coding_category"
          ],
          "description": "empirical_factor = supported by factor analysis; design_category = content blueprint, not a validated subscale; coding_category = group of observation codes."
        },
        "construct_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "item_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "version_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          },
          "description": "Versions this dimension applies to. Omit if it applies to all."
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "needs_check"
      ],
      "properties": {
        "status": {
          "enum": [
            "draft",
            "community_submitted",
            "maintainer_reviewed",
            "source_verified"
          ]
        },
        "reviewed_by": {
          "type": "string"
        },
        "reviewed_on": {
          "type": "string",
          "format": "date"
        },
        "needs_check": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Open questions a reviewer must settle. Must be empty for source_verified."
        }
      }
    }
  }
}
