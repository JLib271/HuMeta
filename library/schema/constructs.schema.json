{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/JLib271/humeta-library/blob/main/schema/constructs.schema.json",
  "title": "Construct vocabulary",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "vocabulary_version",
    "constructs"
  ],
  "properties": {
    "vocabulary_version": {
      "type": "integer",
      "minimum": 1
    },
    "constructs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "domain",
          "definition",
          "synonyms"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(_[a-z0-9]+)*$"
          },
          "label": {
            "type": "string"
          },
          "domain": {
            "enum": [
              "cognitive",
              "affective_motivational",
              "identity_social",
              "epistemological",
              "behavioral_strategy",
              "instructional_practice",
              "environment"
            ]
          },
          "definition": {
            "type": "string",
            "minLength": 15
          },
          "synonyms": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "broader": {
            "type": "string",
            "description": "id of a broader construct, if any."
          },
          "app_variable_keys": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            },
            "description": "Variable keys from the earlier Module 2 that map to this construct (used to convert old variable plans)."
          },
          "eric": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            },
            "description": "ERIC Thesaurus descriptors for the construct (see the HuMeta profile's crosswalks/eric_descriptor_status.json)."
          }
        }
      }
    }
  }
}
