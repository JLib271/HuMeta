{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/JLib271/HuMeta/library/schema/scales.schema.json",
  "title": "Response scales",
  "description": "Shared response scales (code lists). Items and variables point to a scale_id instead of restating labels, so every study codes the same scale the same way.",
  "type": "object",
  "additionalProperties": false,
  "required": ["vocabulary_version", "missing_codes", "scales"],
  "properties": {
    "vocabulary_version": { "type": "integer", "minimum": 1 },
    "missing_codes": {
      "type": "array",
      "description": "Library-wide missing-value codes, used by every scale unless the scale overrides them.",
      "items": { "$ref": "#/$defs/point" }
    },
    "scales": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "level", "points"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "label": { "type": "string" },
          "level": { "enum": ["ordinal", "nominal", "binary"] },
          "description": { "type": "string" },
          "points": {
            "type": "array", "minItems": 2,
            "items": { "$ref": "#/$defs/point" }
          },
          "anchors_only": {
            "type": "boolean",
            "description": "True when only some points have verbal labels on the form (e.g. 1 = Not at all true of me ... 7 = Very true of me); unlabeled points have label null."
          },
          "missing_codes": {
            "type": "array",
            "description": "Overrides the library-wide missing codes for this scale.",
            "items": { "$ref": "#/$defs/point" }
          },
          "reverse_scoring": {
            "type": "string",
            "description": "How to reverse-score an item on this scale, e.g. 'new = 6 - old'."
          }
        }
      }
    }
  },
  "$defs": {
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "label"],
      "properties": {
        "code": { "type": "integer" },
        "label": { "type": ["string", "null"] }
      }
    }
  }
}
