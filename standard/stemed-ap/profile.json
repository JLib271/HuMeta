  "rules": [
    {
      "id": "R1",
      "severity": "error",
      "check": "constructs_required",
      "message": "Datasets and instruments must list at least one construct measured."
    },
    {
      "id": "R2",
      "severity": "error",
      "check": "design_required",
      "message": "Datasets and study registrations must list at least one study design."
    },
    {
      "id": "R3",
      "severity": "error",
      "check": "measurement_evidence_required",
      "message": "Instruments must list at least one kind of measurement evidence."
    },
    {
      "id": "R4",
      "severity": "error",
      "check": "open_requires_deidentified",
      "message": "Open access requires data that are de-identified, anonymous, aggregate-only, synthetic, or not participant data."
    },
    {
      "id": "R5",
      "severity": "error",
      "check": "open_requires_sharing_consent",
      "message": "Open access requires consent for broad sharing (or no human-subjects data)."
    },
    {
      "id": "R6",
      "severity": "error",
      "check": "sharing_requires_review",
      "message": "Data cannot be open or registered-access while human-subjects review is 'not yet assessed' or 'pending'."
    },
    {
      "id": "R7",
      "severity": "error",
      "check": "care_requires_governance",
      "message": "Indigenous data require a governance arrangement and a CARE statement."
    },
    {
      "id": "R8",
      "severity": "error",
      "check": "care_open_requires_agreement",
      "message": "Indigenous data may be open only under a community data governance agreement or tribal review approval."
    },
    {
      "id": "R9",
      "severity": "warning",
      "check": "education_records_review",
      "message": "Data from education records (FERPA): confirm the institution's FERPA review before any sharing."
    },
    {
      "id": "R10",
      "severity": "warning",
      "check": "care_unknown",
      "message": "Indigenous data status is unknown; assess it before sharing."
    },
    {
      "id": "R11",
      "severity": "warning",
      "check": "care_prompt",
      "message": "A specific community or a tribal college is involved; confirm whether the data are Indigenous data."
    },
    {
      "id": "R12",
      "severity": "warning",
      "check": "identifiers_not_shared",
      "message": "Direct identifiers are flagged; they must be removed before the data are shared."
    }
  ],
  "match_types": {
    "exact": "Same meaning; values can be copied directly.",
    "close": "Near-equivalent; usable interchangeably in most cases.",
    "related": "Overlapping meaning; not a substitute."
  }
}
