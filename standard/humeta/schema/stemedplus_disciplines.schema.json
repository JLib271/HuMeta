{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/JLib271/HuMeta/standard/humeta/schema/stemedplus_disciplines.schema.json",
  "title": "STEMEd+ disciplines",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "title",
    "disciplines"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "how_to_match": {
      "type": "string"
    },
    "humeta_note": {
      "type": "string"
    },
    "disciplines": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "definition",
          "humeta_disciplines",
          "match"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "definition": {
            "type": "string",
            "minLength": 10
          },
          "humeta_disciplines": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "match": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "terms",
              "acronyms"
            ],
            "properties": {
              "terms": {
                "type": "string",
                "minLength": 1
              },
              "acronyms": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[A-Z][A-Z0-9]*$"
                }
              },
              "note": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
