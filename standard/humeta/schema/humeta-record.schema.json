{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/JLib271/humeta-profile/blob/main/schema/humeta-record.schema.json",
  "title": "HuMeta profile record (1.0.0-draft.2)",
  "description": "Generated from standard/humeta/profile.json and vocabularies.json by scripts/build_profile_artifacts.py. Do not edit by hand.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile",
    "profile_version",
    "resource",
    "study"
  ],
  "properties": {
    "profile": {
      "const": "humeta"
    },
    "profile_version": {
      "type": "string"
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "creators",
        "publisher",
        "publication_year",
        "resource_type"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "creators": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "orcid": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^(\\d{4}-){3}\\d{3}[\\dX]$"
              },
              "affiliation": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        "publisher": {
          "type": "string",
          "minLength": 1
        },
        "publication_year": {
          "type": "integer",
          "minimum": 1900,
          "maximum": 2100
        },
        "resource_type": {
          "enum": [
            "Dataset",
            "Instrument",
            "StudyRegistration",
            "Text",
            "Software",
            "Collection",
            "Other"
          ]
        },
        "identifier": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "properties": {
            "value": {
              "type": "string"
            },
            "type": {
              "type": "string"
            }
          }
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "keywords": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "language": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]+)*$"
        },
        "license": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "properties": {
            "spdx": {
              "type": [
                "string",
                "null"
              ]
            },
            "name": {
              "type": [
                "string",
                "null"
              ]
            },
            "url": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "funding": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "funder_name"
            ],
            "properties": {
              "funder_name": {
                "type": "string"
              },
              "award_number": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        "collection_dates": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "properties": {
            "start": {
              "type": [
                "string",
                "null"
              ],
              "format": "date"
            },
            "end": {
              "type": [
                "string",
                "null"
              ],
              "format": "date"
            }
          }
        },
        "geography": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "properties": {
            "countries": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Z]{2}$"
              }
            },
            "us_states": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Z]{2}$"
              }
            }
          }
        },
        "related": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "identifier",
              "identifier_type",
              "relation"
            ],
            "properties": {
              "identifier": {
                "type": "string"
              },
              "identifier_type": {
                "enum": [
                  "DOI",
                  "URL",
                  "Handle",
                  "ISBN",
                  "ISSN",
                  "ARK"
                ]
              },
              "relation": {
                "type": "string"
              }
            }
          }
        }
      }
    },
